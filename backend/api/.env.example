# Which code analyses a listing.
#   agent  claimcheck.run_listing, the real agent (default)
#   stub   replays fixtures/expected/ without calling a model
CLAIMCHECK_RUNNER=stub

# Stub only: base pause between events in milliseconds. One run takes about 20 times this.
CLAIMCHECK_STUB_DELAY_MS=150

# Folder holding expected/fixture_NN.json. Default: <repo>/fixtures
# CLAIMCHECK_FIXTURES_DIR=

# Browser origins allowed to call the API, comma separated.
CLAIMCHECK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Largest accepted screenshot, in MB.
CLAIMCHECK_MAX_UPLOAD_MB=10
