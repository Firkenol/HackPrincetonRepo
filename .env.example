# Copy this file to .env and fill it in. Never commit .env.
# `python -m agent` and the live tests load .env from backend/ or the repo root.

# --- Model (required for a live run) ---------------------------------------------
# Passed to LangChain's init_chat_model, so any provider it supports works without
# a code change. MODEL_ID is the provider's own model name.
#
#   MODEL_PROVIDER      package to install       credentials it reads
#   anthropic           (already installed)      ANTHROPIC_API_KEY
#   google_genai        (already installed)      GOOGLE_API_KEY
#   openai              langchain-openai         OPENAI_API_KEY
#   bedrock_converse    (already installed)      AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION
#
# The model must support tool calling. Bedrock is optional.
MODEL_PROVIDER=
MODEL_ID=

# --- Credentials: set only the ones for your MODEL_PROVIDER ------------------------
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- LangSmith tracing (optional) -------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=claimcheck
