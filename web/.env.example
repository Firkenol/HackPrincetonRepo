# Leave unset to replay ../fixtures/expected/ through the built-in mock stream.
# Set to the base URL of the FastAPI service to use the real API instead.
# The Next.js server forwards POST /api/check to <CLAIMCHECK_API_URL>/api/check.
# CLAIMCHECK_API_URL=http://localhost:8000

# Mock only: pause between stream events, in milliseconds (default 90).
# CLAIMCHECK_MOCK_DELAY_MS=90

# Mock only: folder holding fixture_NN.json (default ../fixtures/expected).
# CLAIMCHECK_FIXTURES_DIR=../fixtures/expected
